# Everything runs locally — no API key needed. All settings below are OPTIONAL.
# Copy this file to .env only if you want to override a default.

# Path to the whisper.cpp model (.bin). Default: models/ggml-large-v3-turbo.bin
# TRANSCRIBE_MODEL=models/ggml-large-v3-turbo.bin

# Threads for whisper.cpp. Default: 4 (M3 has 4 performance cores).
# TRANSCRIBE_THREADS=4

# Language is chosen per-run with the -en / -lv flags (default: auto-detect).
