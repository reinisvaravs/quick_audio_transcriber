# This repo ships two transcribers. They share this file but need different keys.
#
#   1. Local CLI  (transcribe.js) — offline whisper.cpp. Every var below is OPTIONAL.
#   2. Telegram bot (bot.js)      — OpenAI API. The three REQUIRED vars are marked.
#
# Copy this file to .env and fill in what you need.


# ---------------------------------------------------------------------------
# 1. Local CLI — node transcribe.js <file|folder|instagram-url>
# ---------------------------------------------------------------------------

# Path to the whisper.cpp model (.bin). Default: models/ggml-large-v3-turbo.bin
# TRANSCRIBE_MODEL=models/ggml-large-v3-turbo.bin

# Threads for whisper.cpp. Default: 4 (M3 has 4 performance cores).
# TRANSCRIBE_THREADS=4

# Language is chosen per-run with the -en / -lv flags (default: auto-detect).

# Endpoint that resolves an Instagram URL to a direct MP4 (Instagram mode).
# Default: downreels.com's backend. Only set this if that service changes.
# Used by both the CLI and the bot.
# INSTAGRAM_API=https://api.zoraahub.com/fetch.php

# Largest Instagram video the bot will pull into memory, in MB. Default: 100.
# INSTAGRAM_MAX_MB=100


# ---------------------------------------------------------------------------
# 2. Telegram bot — node bot.js  (this is what runs on Render)
# ---------------------------------------------------------------------------

# REQUIRED. From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# REQUIRED. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# REQUIRED. Comma-separated numeric Telegram user IDs allowed to use the bot.
# Everyone else is ignored silently. Get yours from @userinfobot.
TELEGRAM_ALLOWED_IDS=

# Transcription model. Default: gpt-4o-transcribe (best accuracy).
# Cheaper alternative: whisper-1
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Force a language with an ISO-639-1 code (en, lv, ...). Default: auto-detect.
# Can also be overridden per file by captioning it "-en" or "-lv".
# TRANSCRIBE_LANGUAGE=auto

# Shared secret Telegram sends back on every webhook request, so nobody else can
# post fake updates to your URL. Any random string. Defaults to part of the bot
# token if unset — set it explicitly in production.
# WEBHOOK_SECRET=

# Public HTTPS base URL of the deployment. On Render this is set automatically
# via RENDER_EXTERNAL_URL, so leave it blank there. Leave blank locally too —
# with no public URL the bot falls back to long polling.
# PUBLIC_URL=

# Port for the webhook server. Render sets this for you. Default: 3000
# PORT=3000
