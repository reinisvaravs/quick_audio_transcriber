{
  "name": "quick_audio_transcriber",
  "version": "2.0.0",
  "description": "Two transcribers, one codebase: an offline whisper.cpp CLI, and a Telegram bot backed by the OpenAI API",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "transcription",
    "whisper",
    "whisper.cpp",
    "offline",
    "speech-to-text",
    "cli",
    "ffmpeg",
    "telegram",
    "telegram-bot",
    "openai"
  ],
  "bin": {
    "transcribe": "./transcribe.js"
  },
  "scripts": {
    "start": "node bot.js",
    "bot": "node bot.js",
    "cli": "node transcribe.js",
    "postinstall": "node -e \"require('fs').mkdirSync('output',{recursive:true})\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.3.0",
    "openai": "^6.49.0"
  }
}
